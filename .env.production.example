# ==========================================
# ENV Variables for Portainer Swarm
# Copie o conteúdo abaixo e preencha na aba "Environment variables"
# ==========================================

# 1. Banco de Dados (PostgreSQL)
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# 2. JWT (Auth)
# Gere usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_token_with_at_least_32_characters_long
JWT_EXPIRY=3600

# 3. URLs e Domínios
SITE_URL=https://franhair.com
NEXT_PUBLIC_SITE_URL=https://franhair.com

# 4. SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=FranHair

# 5. Integrações
ASAAS_API_KEY=your_asaas_api_key
ASSAAS_WEBHOOK_TOKEN=your_asaas_webhook_token

# 6. Google OAuth (Single Sign-On)
# Crie em https://console.cloud.google.com/apis/credentials
# Redirect URI: https://franhair.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_SECRET=your_google_secret_here

# 7. OpenAI (Provador Virtual)
OPENAI_API_KEY=your_openai_api_key_here

# 8. MCP (Inteligência Artificial conectada ao painel)
# Gere usando: openssl rand -hex 32
# Token de acesso do endpoint /api/mcp — a IA que você conectar usa ele no header Authorization: Bearer <token>
MCP_ADMIN_TOKEN=your_mcp_admin_token_here

# 9. Backup automático (1x/dia às 00:00, fuso America/Sao_Paulo)
# Pasta dos arquivos .backup.json.gz (volume Docker persistente, fora do Git)
BACKUP_DIR=/backups
# Quantos dias manter os backups antes de excluir
BACKUP_RETENTION_DAYS=7
# Fuso horário do agendamento (00:00 local)
BACKUP_TZ=America/Sao_Paulo
